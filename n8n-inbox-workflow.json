    {
      "parameters": {
        "promptType": "define",
        "text": "=/no_think\nClassify this email. Allowed answers: {{ $json.cleanup.isBulk ? 'receipts, newsletters, clutter, review' : 'priority, review' }}.\n- priority: a real person writing to me, needs a reply or action\n- receipts: invoices, bills, payments, order confirmations\n- newsletters: digests or updates I subscribed to\n- clutter: ads, cold sales outreach, spam\n- review: unsure\n\nExamples:\nFrom: ali@client.com | Subject: Can we move the call to 3pm? -> {\"category\":\"priority\",\"reason\":\"person asks to reschedule\"}\nFrom: no-reply@store.com | Subject: 50% off today only -> {\"category\":\"clutter\",\"reason\":\"advert\"}\nFrom: news@substack.com | Subject: This week in AI -> {\"category\":\"newsletters\",\"reason\":\"digest\"}\nWhen unsure answer review.\n\nReturn ONLY JSON: {\"category\":\"...\",\"reason\":\"...\"}\n\nFrom: {{ $json.From || $json.from }}\nSubject: {{ $json.Subject || $json.subject }}\nSnippet: {{ String($json.snippet || '').slice(0, 300) }}"
      },
      "id": "aded90a4-5cb8-4898-b2df-a1ffd7e09bcb",
      "name": "AI Email Classifier",
