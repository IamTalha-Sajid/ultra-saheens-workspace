    {
      "parameters": {
        "jsCode": "const valid = ['priority', 'receipts', 'newsletters', 'clutter', 'review'];\n\nreturn $input.all().map((item, i) => {\n  const orig = $('Pre-LLM Router').itemMatching(i).json;   // paired by lineage, not position\n  const raw = String(item.json.text ?? item.json.response ?? item.json.output ?? '')\n    .replace(/<think>[\\s\\S]*?<\\/think>/gi, '')\n    .replace(/```json|```/gi, '');\n\n  let cat = 'review';\n  let reason = 'parse fallback';\n  try {\n    const p = JSON.parse(raw.match(/\\{[\\s\\S]*\\}/)[0]);\n    cat = String(p.category || '').toLowerCase().trim();\n    reason = p.reason || '';\n  } catch (e) {}\n  if (!valid.includes(cat)) cat = 'review';\n\n  const c = orig.cleanup || {};\n  if (cat === 'priority' && c.isBulk) { cat = 'review'; reason += ' [guard: bulk sender cannot be priority]'; }\n  if ((cat === 'clutter' || cat === 'newsletters') && c.isPersonal) { cat = 'review'; reason += ' [guard: personal/important cannot be binned]'; }\n  if (cat === 'clutter' && !c.isBulk) { cat = 'review'; reason += ' [guard: human sender cannot be clutter]'; }\n\n  return { json: { ...orig, ai: { category: cat, reason } } };\n});"
      },
