    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst DAY_MS = 24 * 60 * 60 * 1000;\n\n// ===== EDIT THESE =====\nconst VIP = ['yourboss@company.com', 'client.com'];      // exact addresses or domains -> always priority\nconst MUST_KEEP = /\\b(interview|offer letter|contract|deadline|overdue|appointment|visa|court|tax|salary|payment failed|action required)\\b/;\nconst BANK_SENDERS = /meezanbank\\.com/;                   // bank/payment sender domains\n// ======================\n\nreturn $input.all().map((item) => {\n  const msg = item.json;\n  const labels = msg.labelIds || [];\n  const isUnread = labels.includes('UNREAD');\n  const hasDate = !!msg.internalDate;\n  const ageDays = hasDate ? (now - Number(msg.internalDate)) / DAY_MS : 0;\n\n  const from = String(msg.From || msg.from || '').toLowerCase();\n  const subject = String(msg.Subject || msg.subject || '').toLowerCase();\n  const snippet = String(msg.snippet || '').toLowerCase();\n  const blob = `${from} ${subject} ${snippet}`;\n\n  const isPromo = labels.includes('CATEGORY_PROMOTIONS');\n  const isBulk = !!(msg['List-Unsubscribe'] || msg.listUnsubscribe)\n    || /no-?reply|do-?not-?reply|newsletter|mailer|notifications?@|marketing|updates?@/.test(from)\n    || labels.some(l => ['CATEGORY_PROMOTIONS', 'CATEGORY_UPDATES', 'CATEGORY_FORUMS'].includes(l));\n  const isPersonal = labels.some(l => ['IMPORTANT', 'STARRED', 'CATEGORY_PERSONAL'].includes(l));\n\n  const isVip = VIP.some(v => from.includes(v.toLowerCase()));\n  const isSecurityAlert = /\\b(fraud|unauthorized|suspicious login|new sign-in|new login|security alert|account locked|password reset)\\b/.test(blob);\n  const isOtp = /\\b(otp|one-time password|verification code|security code|2fa|login code)\\b/.test(blob);\n  const isBankSender = BANK_SENDERS.test(from);\n  const isBankLogin = isBankSender && /\\b(logged on|logged in|log in|login|sign-in|signed in)\\b/.test(blob);\n  const isBankTxn = isBankSender && /\\b(debit|debited|credit|credited|transaction|transfer|payment|statement|bill|raast|1bill|rs\\.?|pkr|balance)\\b/.test(blob);\n  const isBankOrPayment = isBankTxn\n    || /\\b(transaction alert|debit alert|credit alert|funds transfer|payment received|order confirmation|billing statement|your receipt|your invoice)\\b/.test(subject);\n\n  let fastAction = 'llm';\n  let fastReason = 'Requires LLM classification';\n\n  if (isVip) { fastAction = 'priority'; fastReason = 'VIP sender'; }\n  else if (isOtp) {\n    if (!hasDate || ageDays * 1440 > 15) { fastAction = 'bin'; fastReason = 'Expired OTP (>15 min)'; }\n    else { fastAction = 'skip'; fastReason = 'OTP still valid, left for next run'; }\n  }\n  else if (isBankLogin && !isBankTxn) { fastAction = 'archive_read'; fastReason = 'Bank login notice (informational)'; }\n  else if (isSecurityAlert) {\n    if (ageDays > 5) { fastAction = 'archive_read'; fastReason = 'Old security alert (>5d)'; }\n    else { fastAction = 'priority'; fastReason = 'Fresh security alert'; }\n  }\n  else if (isBankOrPayment) { fastAction = 'receipts'; fastReason = 'Bank/payment sender or subject'; }\n  else if (MUST_KEEP.test(subject) && !isPromo) { fastAction = 'priority'; fastReason = 'Must-keep keyword in subject'; }\n  else if (isPromo) { fastAction = 'bin'; fastReason = 'Gmail Promotion -> AI/Bin (recoverable 7d)'; }\n  else if (labels.includes('CATEGORY_SOCIAL')) { fastAction = 'archive_read'; fastReason = 'Gmail Social'; }\n  else if (!isUnread && hasDate && ageDays > 14) { fastAction = 'archive_read'; fastReason = 'Read and older than 14 days'; }\n\n  return { json: { ...msg, cleanup: { fastAction, fastReason, ageDays: Math.round(ageDays * 10) / 10, isUnread, isBulk, isPersonal } } };\n}).filter(i => i.json.cleanup.fastAction !== 'skip');"
      },
